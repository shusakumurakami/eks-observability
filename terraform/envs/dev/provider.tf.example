# Example provider configuration for dev environment
# This shows how to use default_tags instead of explicitly tagging each resource

terraform {
  required_version = ">= 1.9.0"

  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = "~> 6.0"
    }
  }

  # Uncomment and configure for remote state
  # backend "s3" {
  #   bucket         = "your-terraform-state-bucket"
  #   key            = "eks-observability/dev/terraform.tfstate"
  #   region         = "us-west-2"
  #   encrypt        = true
  #   dynamodb_table = "terraform-state-lock"
  # }
}

provider "aws" {
  region = var.region

  # Default tags applied to all resources created by this provider
  # This eliminates the need to explicitly tag each resource in the modules
  default_tags {
    tags = {
      Environment = "dev"
      Project     = "eks-observability"
      ManagedBy   = "Terraform"
      Repository  = "eks-observability"
      Owner       = "platform-team"
    }
  }
}
